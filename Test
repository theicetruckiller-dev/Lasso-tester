local BuyTreatEvent = nil

-- GÜNCELLENDİ: Sadece seçili olan meyveyi satın almayı dener
local function AttemptToBuySelectedFruit()
    if not _G.AutoBuyTreats or not BuyTreatEvent or not _G.SelectedFruitToBuy then
        return
    end
    
    local fruitToBuy = _G.SelectedFruitToBuy
    -- 10 kere almayı dener
    for i = 1, 10 do
        pcall(function() BuyTreatEvent:FireServer(fruitToBuy) end)
        task.wait(0.05)
    end
end

-- GÜNCELLENDİ: Yeni Auto Buy butonu
AutoBuyToggleButton.MouseButton1Click:Connect(function()
    _G.AutoBuyTreats = not _G.AutoBuyTreats
    if _G.AutoBuyTreats then
        AutoBuyToggleButton.Text = "Auto Buy: ON"
        AutoBuyToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        AttemptToBuySelectedFruit() -- Sadece seçili olanı almayı başlat
    else
        AutoBuyToggleButton.Text = "Auto Buy: OFF"
        AutoBuyToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

