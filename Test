-- ANA SCRIPT MANTIĞI (TÜMÜ AYNI)
local function UpdateSlider(value) local min, max = 16, 150; local percentage = (value - min) / (max - min); SliderHandle.Position = UDim2.new(percentage, -10, 0.5, -10); _G.WalkSpeed = value; SpeedSliderLabel.Text = "Speed: " .. math.floor(value) end
MediumSpeedButton.MouseButton1Click:Connect(function() UpdateSlider(60) end)
FastSpeedButton.MouseButton1Click:Connect(function() UpdateSlider(120) end)
ResetSpeedButton.MouseButton1Click:Connect(function() UpdateSlider(16) end)
local isDragging = false; SliderHandle.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then isDragging = true end end); SliderHandle.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then isDragging = false end end); UserInputService.InputChanged:Connect(function(input) if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then local mouseX = input.Position.X; local startX = SliderBackground.AbsolutePosition.X; local width = SliderBackground.AbsoluteSize.X; local percentage = math.clamp((mouseX - startX) / width, 0, 1); local min, max = 16, 150; local newValue = min + (max - min) * percentage; UpdateSlider(newValue) end end)
ToggleVisibilityButton.MouseButton1Click:Connect(function() MainFrame.Visible = not MainFrame.Visible; ToggleVisibilityButton.Text = MainFrame.Visible and "Hide" or "Show" end)
AutoReturnButton.MouseButton1Click:Connect(function() _G.AutoReturnEnabled = not _G.AutoReturnEnabled; if _G.AutoReturnEnabled then AutoReturnButton.Text = "Auto Return: ON"; AutoReturnButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50) else AutoReturnButton.Text = "Auto Return: OFF"; AutoReturnButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50) end end)
AutoCollectWheatButton.MouseButton1Click:Connect(function() _G.AutoCollectWheatEnabled = not _G.AutoCollectWheatEnabled; if _G.AutoCollectWheatEnabled then AutoCollectWheatButton.Text = "Auto Collect Wheat: ON"; AutoCollectWheatButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50) else AutoCollectWheatButton.Text = "Auto Collect Wheat: OFF"; AutoCollectWheatButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50) end end)
local fruitsToBuy = {"Carrot", "Apple", "Corn", "Pepper", "Banana", "Cherries"}; local BuyTreatEvent = nil
local function AttemptToBuyAllFruits() if not _G.AutoBuyTreats or not BuyTreatEvent then return end; for _, fruitName in ipairs(fruitsToBuy) do for i = 1, 10 do pcall(function() BuyTreatEvent:FireServer(fruitName) end); task.wait(0.05) end end end
AutoBuyButton.MouseButton1Click:Connect(function() _G.AutoBuyTreats = not _G.AutoBuyTreats; if _G.AutoBuyTreats then AutoBuyButton.Text = "Auto Buy: ON"; AutoBuyButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50); AttemptToBuyAllFruits() else AutoBuyButton.Text = "Auto Buy: OFF"; AutoBuyButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50) end end)
task.spawn(function() while task.wait(0.2) do pcall(function() if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then LocalPlayer.Character.Humanoid.WalkSpeed = _G.WalkSpeed end end) end end)
local function UpdatePenLocation(character) pcall(function() if not character then return end; task.wait(1.5); local humanoidRootPart = character:FindFirstChild("HumanoidRootPart"); if humanoidRootPart then currentPenLocation = humanoidRootPart.Position end end) end
LocalPlayer.CharacterAdded:Connect(UpdatePenLocation)
local function GetMyPlot()
    if not currentPenLocation then return nil end
    local plotsFolder = workspace.Map:WaitForChild("Plots")
    local closestPlot, shortestDist = nil, math.huge
    for _, plot in ipairs(plotsFolder:GetChildren()) do
        if plot:IsA("Model") and plot.PrimaryPart then
            local dist = (plot.PrimaryPart.Position - currentPenLocation).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                closestPlot = plot
            end
        end
    end
    return closestPlot
end
local RemoteEvents = ReplicatedStorage:WaitForChild("Remote_Events", 10)
if RemoteEvents then
    local RestockEvent = RemoteEvents:WaitForChild("NOT", 5)
    BuyTreatEvent = RemoteEvents:WaitForChild("Buy_Treat", 5)
    local CaptureFXEvent = RemoteEvents:WaitForChild("Capture_FX", 5)
    if RestockEvent and BuyTreatEvent then
        RestockEvent.OnClientEvent:Connect(function(message) if message == "The treat shop has been restocked!" then AttemptToBuyAllFruits() end end)
    end
    if CaptureFXEvent then
        CaptureFXEvent.OnClientEvent:Connect(function(playerWhoCaptured, capturedAnimal)
            if not _G.AutoReturnEnabled then return end
            if playerWhoCaptured == LocalPlayer then
                local character = LocalPlayer.Character; local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
                if humanoidRootPart and currentPenLocation then task.wait(0.1); humanoidRootPart.CFrame = CFrame.new(currentPenLocation) end
            end
        end)
    end
    task.spawn(function()
        while task.wait(1) do
            if _G.AutoCollectWheatEnabled then
                pcall(function()
                    local myPlot = GetMyPlot()
                    local character = LocalPlayer.Character
                    local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
                    if myPlot and humanoidRootPart then
                        local animalsFolder = myPlot:FindFirstChild("Animals")
                        if animalsFolder then
                            for _, animal in ipairs(animalsFolder:GetChildren()) do
                                local hitbox = animal:FindFirstChild("TouchHitbox")
                                if hitbox then
                                    humanoidRootPart.CFrame = CFrame.new(hitbox.Position)
                                    task.wait(0.7)
                                end
                            end
                            if currentPenLocation then humanoidRootPart.CFrame = CFrame.new(currentPenLocation) end
                        end
                    end
                end)
            end
        end
    end)
end
